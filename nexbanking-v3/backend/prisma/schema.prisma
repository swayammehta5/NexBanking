generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum AccountType {
  savings
  checking
  investment
}

enum TransactionType {
  deposit
  withdrawal
  transfer_in
  transfer_out
}

enum TransactionStatus {
  pending
  completed
  failed
  reversed
  suspicious
}

enum NotificationType {
  credit
  debit
  transfer
  beneficiary_added
  password_changed
  new_login
  fraud_alert
  system
}

enum ActivityAction {
  login
  logout
  transfer
  deposit
  withdrawal
  profile_update
  password_change
  beneficiary_added
  beneficiary_deleted
  admin_freeze
  admin_unfreeze
  admin_deactivate
  admin_password_reset
  pin_set
  pin_change
}

model User {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String    @unique
  password           String
  phone              String?
  avatar             String    @default("")
  role               Role      @default(user)
  isActive           Boolean   @default(true)
  isFrozen           Boolean   @default(false)
  lastLogin          DateTime?
  loginHistory       Json      @default("[]")
  transactionPinHash String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account        Account?
  transactions   Transaction[]
  beneficiaries  Beneficiary[]
  notifications  Notification[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Account {
  id                 String      @id @default(cuid())
  userId             String      @unique
  accountNumber      String      @unique
  accountType        AccountType @default(savings)
  balance            Decimal     @default(0) @db.Decimal(19, 2)
  currency           String      @default("USD")
  isActive           Boolean     @default(true)
  dailyTransferLimit Decimal     @default(10000) @db.Decimal(19, 2)
  totalDeposited     Decimal     @default(0) @db.Decimal(19, 2)
  totalWithdrawn     Decimal     @default(0) @db.Decimal(19, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                      String            @id @default(cuid())
  transactionId           String            @unique
  userId                  String
  accountId               String
  type                    TransactionType
  amount                  Decimal           @db.Decimal(19, 2)
  balanceBefore           Decimal           @db.Decimal(19, 2)
  balanceAfter            Decimal           @db.Decimal(19, 2)
  description             String?
  recipientAccountNumber  String?
  senderAccountNumber     String?
  beneficiaryId           String?
  status                  TransactionStatus @default(completed)
  isSuspicious            Boolean           @default(false)
  fraudFlags              String[]          @default([])
  metadata                Json              @default("{}")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([isSuspicious])
  @@index([status])
  @@map("transactions")
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  name          String
  accountNumber String
  nickname      String?
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, accountNumber])
  @@index([userId, isFavorite])
  @@map("beneficiaries")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String?
  action      ActivityAction
  description String?
  ip          String?
  userAgent   String?
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("activity_logs")
}
