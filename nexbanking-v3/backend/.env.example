NODE_ENV=development
PORT=5000

# PostgreSQL connection string (required)
# Local example:
DATABASE_URL=postgresql://username:password@localhost:5432/nexbanking?schema=public

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin. On Render this must be the deployed frontend URL,
# never a localhost URL.
CLIENT_URL=http://localhost:5173

# Rate Limiting (optional; defaults used in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
